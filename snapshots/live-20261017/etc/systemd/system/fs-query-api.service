[Unit]
Description=FS project-scoped readonly query API
After=network.target fs-business-range.service

[Service]
Type=simple
ExecStart=/opt/python39/bin/python3 -B /opt/fs-query-api/query_api.py
User=nobody
Group=nobody
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
