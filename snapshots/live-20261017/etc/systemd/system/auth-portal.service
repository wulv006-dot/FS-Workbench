[Unit]
Description=MMOEXP Unified Auth Portal (login page + auth_request backend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/auth-portal
EnvironmentFile=/opt/auth-portal/config.env
ExecStart=/opt/python39/bin/python3 /opt/auth-portal/auth_portal.py
Restart=always
RestartSec=3
MemoryLimit=120M
CPUQuota=40%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWriteDirectories=/opt/auth-portal/data

[Install]
WantedBy=multi-user.target
