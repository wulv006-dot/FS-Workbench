[Unit]
Description=FS read-only marketing custom dates
After=network-online.target
[Service]
Type=simple
User=root
UMask=0077
WorkingDirectory=/opt/mmoexp-marketing/custom-range
ExecStart=/opt/mmoexp-marketing/venv-ssl/bin/python /opt/mmoexp-marketing/custom-range/range_api.py
Restart=on-failure
RestartSec=5
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
