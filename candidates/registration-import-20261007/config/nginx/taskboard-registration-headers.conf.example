# Review-only directives inside the existing protected taskboard API location.
# Keep its current proxy_pass, body handling, TLS and other unrelated directives.
auth_request /__auth_verify;
auth_request_set $auth_user $upstream_http_x_auth_user;
auth_request_set $registration_taskboard_role $upstream_http_x_auth_role;
auth_request_set $registration_taskboard_groups $upstream_http_x_auth_groups;
error_page 401 = @auth_login;
proxy_set_header X-Auth-User $auth_user;
proxy_set_header X-Auth-Role $registration_taskboard_role;
proxy_set_header X-Auth-Groups $registration_taskboard_groups;
