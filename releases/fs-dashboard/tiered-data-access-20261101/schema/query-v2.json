{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FS bounded query structural contract; dataset whitelist and authorization remain runtime checks",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "start", "end_exclusive", "timezone", "site_id", "game_id", "grain", "fields", "mode", "budget_profile", "reason", "policy_version"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 1000},
    "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "end_exclusive": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "timezone": {"type": "string", "minLength": 1, "maxLength": 1000},
    "site_id": {"type": "string", "minLength": 1, "maxLength": 1000},
    "game_id": {"type": "string", "minLength": 1, "maxLength": 1000},
    "grain": {"type": "string", "minLength": 1, "maxLength": 1000},
    "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "mode": {"enum": ["fresh", "archive", "frozen"]},
    "budget_profile": {"type": "string", "minLength": 1, "maxLength": 1000},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 1000},
    "filters": {"type": "object", "additionalProperties": {"type": "string"}},
    "source_preference": {"enum": ["auto", "Admin", "Order", "local"]},
    "cursor": {"type": ["string", "null"]},
    "snapshot_id": {"type": ["string", "null"]},
    "snapshot_revision": {"type": ["string", "null"]}
  }
}
