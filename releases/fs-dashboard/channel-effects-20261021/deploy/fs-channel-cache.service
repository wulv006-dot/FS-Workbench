[Unit]
Description=FS channel effects yesterday verified cache
After=network-online.target

[Service]
Type=simple
StartLimitInterval=6h
StartLimitBurst=12
User=root
UMask=0077
ExecStart=/opt/python39/bin/python3 -B /opt/fs-hermes-fc/channel_cache.py
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
Restart=on-failure
RestartSec=5min
