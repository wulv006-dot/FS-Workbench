[Unit]
Description=Hermes FC read-only investigation runtime
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStartPre=/opt/python39/bin/python3 -B /opt/fs-hermes-fc/network_guard.py apply
ExecStart=/usr/bin/docker run --rm --name fs-hermes-fc --network host --read-only --user 9876:9876 --cap-drop ALL --security-opt no-new-privileges --pids-limit 256 --memory 2g --tmpfs /tmp:rw,nosuid,nodev,size=268435456 --env HOME=/profile --env HERMES_HOME=/profile --env PYTHONPATH=/opt/hermes:/opt/pilot --env PYTHONDONTWRITEBYTECODE=1 --env HERMES_REDACT_SECRETS=true --mount type=bind,source=/opt/fs-hermes-fc,target=/opt/pilot,readonly --mount type=bind,source=/run/fs-hermes-fc,target=/run/fs-hermes-fc,readonly --mount type=bind,source=/var/lib/fs-hermes-fc/profile,target=/profile --mount type=bind,source=/opt/fs-hermes-fc/runtime-config.yaml,target=/profile/config.yaml,readonly sha256:8251bc53f66565fa9aaf2dea3292ec2ae91db7f3eb57c44f5804ebf6b6853544 /opt/pilot/hermes_worker.py
ExecStop=/usr/bin/docker stop --time 25 fs-hermes-fc
ExecStopPost=/opt/python39/bin/python3 -B /opt/fs-hermes-fc/network_guard.py remove
TimeoutStartSec=90
TimeoutStopSec=45
Restart=no
UMask=0077

[Install]
WantedBy=multi-user.target
