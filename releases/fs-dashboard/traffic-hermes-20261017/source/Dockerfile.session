# Build with --pull=false --network=none and the required exact local image ID.
# Stage traffic_contract.py from this candidate's mmoexp_google_data/details/.
ARG SESSION_BASE_IMAGE
FROM ${SESSION_BASE_IMAGE}
ARG SESSION_BASE_IMAGE
COPY p2pah_session_service.py es_order_structure.py traffic_contract.py /usr/local/bin/
RUN python3 -c 'import os,py_compile; assert os.environ["SESSION_BASE_IMAGE"] == "sha256:88963f9429c84615a7ba24623cf0f54a7d4c313644c64092098e0adb52e835d8", "session_base_image_mismatch"; [py_compile.compile("/usr/local/bin/"+p,doraise=True) for p in ("p2pah_session_service.py","es_order_structure.py","traffic_contract.py")]'
