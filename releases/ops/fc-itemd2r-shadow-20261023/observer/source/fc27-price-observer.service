[Unit]
Description=FC27 independent competitor price observations and shadow scenarios
After=docker.service

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/python39/bin/python3 -B /opt/fc27-price-observer/observe.py
TimeoutStartSec=80
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=15
StartLimitInterval=300
StartLimitBurst=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
MemoryLimit=384M
CPUQuota=20%
