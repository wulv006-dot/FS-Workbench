[Unit]
Description=Publish FC27 matchday pilot card to test guild
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mmoexp-fc-community
Group=mmoexp-fc-community
WorkingDirectory=/opt/fc27-matchday-discord-stage
EnvironmentFile=/etc/mmoexp-fc-community.env
ExecStart=/usr/bin/python3 /opt/fc27-matchday-discord-stage/matchday_publish.py test
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWriteDirectories=/opt/fc27-matchday-discord-stage/var
UMask=0077
