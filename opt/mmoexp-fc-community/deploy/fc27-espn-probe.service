[Unit]
Description=FC27 ESPN scoreboard read-only trial
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mmoexp-fc-matchday-probe-20261114
ExecStart=/usr/bin/python3 /opt/mmoexp-fc-matchday-probe-20261114/matchday_espn_probe.py --log /opt/mmoexp-fc-matchday-probe-20261114/probe.jsonl --snapshot-dir /opt/mmoexp-fc-matchday-probe-20261114/snapshots
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
