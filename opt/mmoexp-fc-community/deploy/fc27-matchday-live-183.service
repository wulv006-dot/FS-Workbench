[Unit]
Description=FC27 focus-match low-latency collector on 183
After=network-online.target fc27-matchday-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=fc27-match-fetch
Group=fc27-match-fetch
WorkingDirectory=/opt/fc27-matchday-collector
ExecStart=/usr/bin/python3 /opt/fc27-matchday-collector/matchday_live.py
UMask=0077
TimeoutStartSec=25
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fc27-matchday-collector
